# Umami analytics. Copy to .env and fill in to enable; leave unset and no
# analytics tag is emitted at all.
#
# These are read at BUILD time, not at runtime — Astro inlines PUBLIC_* into
# the static HTML. Set them wherever the build happens: Vercel's environment
# variables, or --build-arg for the Dockerfile.

# From the Umami dashboard: Settings -> Websites -> your site -> Website ID.
PUBLIC_UMAMI_WEBSITE_ID=

# Only needed when self-hosting. Defaults to Umami Cloud.
# PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js

# ---------------------------------------------------------------------------
# The Railway bucket nginx serves at /files/. Copy these out of the bucket's
# Credentials tab. Unlike the PUBLIC_* pair above these are RUNTIME variables:
# the container reads them when it answers a request, and `npm run files`
# reads them from this file to upload. Nothing here reaches the built site.
#
# Leave them unset and the site is exactly the site it was — only /files/
# stops working. `npm run files` reads .env and then .env.local, the latter
# winning, the way Astro resolves them.

BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=https://t3.storageapi.dev

# Only for a bucket old enough to want path-style URLs — its Credentials tab
# says so. Leave unset for the virtual-hosted style Railway issues today.
# S3_PATH_STYLE=1
