---
import Layout from '../layouts/Layout.astro'
import CollapsibleSection from '../components/CollapsibleSection.astro'
import SocialIcon from '../components/SocialIcon.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { Content as Bio } from '../data/bio.md'
import { educationData } from '../data/education'
import { experienceData } from '../data/experience'
import { musicProjects } from '../data/music'
import { projects } from '../data/projects'
import { socialLinks, sourceRepo } from '../data/social'
import { talks } from '../data/talks'
import { writingEntries } from '../lib/articles'

const year = new Date().getFullYear()

// Self-hosted articles first, then the posts on other people's domains. The
// Markdown twins render from this same list, so the two cannot disagree.
const writing = await writingEntries()
---

<Layout
  title="Hélder Vasconcelos - Personal Website"
  description="Software Engineer, CTO and Co-Founder at LayerX / TAIKAI based in Porto. Agentic workflows, LLM inference and High performance systems."
>
  <main class="mx-auto min-h-screen max-w-2xl px-6 py-24">
    {/* Header/Name */}
    <header class="mb-12 flex items-start justify-between gap-4">
      <div class="flex items-center gap-5">
        {/* Fixed-size circle; the photo scales inside it and is clipped. */}
        <div
          class="group relative h-20 w-20 shrink-0 overflow-hidden rounded-full sm:h-24 sm:w-24"
        >
          <img
            src="/avatar.jpg"
            alt="Hélder Vasconcelos"
            width="96"
            height="96"
            class="h-full w-full object-cover grayscale transition-[filter,transform] duration-500 group-hover:scale-110 group-hover:grayscale-0"
          />
          <span
            class="crt pointer-events-none absolute inset-0 rounded-full opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            aria-hidden="true"></span>
        </div>
        <div>
          <p class="mb-1 font-mono text-xs text-gray-500">
            <span class="text-accent">helder@hvasc</span>:<span
              class="text-gray-400">~</span
            >$ whoami
          </p>
          <h1
            class="mb-2 text-3xl font-medium tracking-tight text-gray-900 sm:text-4xl"
          >
            Hélder Vasconcelos<span class="caret ml-1" aria-hidden="true"
              >▋</span
            >
          </h1>
          <p class="font-mono text-sm text-gray-500">Porto, Portugal 🇵🇹</p>
        </div>
      </div>
      <ThemeToggle />
    </header>

    {/* Bio Section */}
    <CollapsibleSection id="about" title="About">
      <div
        class="text-sm leading-relaxed text-justify hyphens-auto text-gray-700 [&_a]:text-accent [&_a]:border-b [&_a]:border-gray-300 [&_a]:transition-colors [&_a:hover]:border-accent [&_a:hover]:opacity-70 [&_em]:italic [&_p]:mb-4 [&_p:last-child]:mb-0 [&_p:last-child]:text-left"
      >
        <Bio />
      </div>
    </CollapsibleSection>

    {/* Side Projects Section */}
    <CollapsibleSection id="projects" title="Side Projects">
      <ul class="space-y-6">
        {
          projects.map((project) => (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
              >
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <h3 class="font-medium text-gray-900 transition-colors group-hover:text-gray-600">
                    {project.name}
                  </h3>
                  {project.language && (
                    <span class="font-mono text-xs text-gray-500">[{project.language}]</span>
                  )}
                </div>
                <p class="mt-1 text-sm leading-relaxed text-gray-600">
                  {project.description}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </CollapsibleSection>

    {/* Blog Posts Section */}
    <CollapsibleSection id="writing" title="Writing">
      <ul class="space-y-6">
        {
          writing.map((post) => (
            <li>
              <a
                href={post.url}
                class="group block"
              >
                <h3 class="mb-1 text-gray-900 transition-colors group-hover:text-gray-600">
                  {post.title}
                </h3>
                <time class="font-mono text-xs text-gray-500">{post.date}</time>
              </a>
            </li>
          ))
        }
      </ul>
    </CollapsibleSection>

    {/* Recent Talks Section */}
    <CollapsibleSection id="talks" title="Recent Talks">
      <ul class="space-y-6">
        {
          talks.map((talk) => {
            {/* Only a talk with slides or a recording becomes a link. */}
            const Wrapper = talk.url ? 'a' : 'div'
            return (
              <li>
                <Wrapper
                  href={talk.url}
                  target={talk.url ? '_blank' : undefined}
                  rel={talk.url ? 'noopener noreferrer' : undefined}
                  class={talk.url ? 'group block' : 'block'}
                >
                  {/*
                    The hover tint is the affordance for "this is clickable", so
                    it is only worth having on the ones that are.
                  */}
                  <h3
                    class:list={[
                      'mb-1 text-gray-900',
                      talk.url && 'transition-colors group-hover:text-gray-600',
                    ]}
                  >
                    {talk.title}
                  </h3>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="font-mono text-xs text-gray-500">
                      {talk.event}
                    </span>
                    <span class="font-mono text-xs text-gray-400" aria-hidden="true">
                      ·
                    </span>
                    <time class="font-mono text-xs text-gray-500">
                      {talk.date}
                    </time>
                  </div>
                </Wrapper>
              </li>
            )
          })
        }
      </ul>
    </CollapsibleSection>

    {/* Experience Section */}
    <CollapsibleSection id="experience" title="Experience">
      <div class="space-y-8">
        {
          experienceData.map((exp) => (
            <div class="border-l-2 border-gray-200 pl-4 transition-colors hover:border-gray-400">
              <h3 class="font-medium text-gray-900">{exp.company}</h3>
              <p class="text-sm text-gray-700">{exp.role}</p>
              <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="font-mono text-xs text-gray-500">
                  {exp.period}
                </span>
                <span class="text-gray-300">·</span>
              </div>
              <p class="mt-1 text-xs text-gray-500">{exp.location}</p>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">
                {exp.description}
              </p>
              {exp.technologies && exp.technologies.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {exp.technologies.map((tech) => (
                    <span class="font-mono text-xs text-gray-500">[{tech}]</span>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </CollapsibleSection>

    {/* Education Section */}
    <CollapsibleSection id="education" title="Education">
      <div class="space-y-8">
        {
          educationData.map((edu) => (
            <div class="border-l-2 border-gray-200 pl-4 transition-colors hover:border-gray-400">
              <h3 class="font-medium text-gray-900">{edu.institution}</h3>
              <p class="text-sm text-gray-700">{edu.degree}</p>
              <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="font-mono text-xs text-gray-500">
                  {edu.period}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </CollapsibleSection>

    {/* Music Section */}
    <CollapsibleSection id="music" title="Music">
      <div class="space-y-10">
        {
          musicProjects.map((project) => (
            <div>
              <h3 class="font-mono text-sm text-gray-900">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent border-b border-gray-300 transition-colors hover:border-accent hover:opacity-70"
                >
                  {project.name}
                </a>
              </h3>
              <p class="mt-2 mb-6 text-sm leading-relaxed text-gray-600">
                {project.description}
              </p>
              <ul class="space-y-6">
                {project.releases.map((release) => (
                  <li>
                    <a
                      href={release.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group block"
                    >
                      <h4 class="mb-1 font-medium text-gray-900 transition-colors group-hover:text-gray-600">
                        {release.title}
                      </h4>
                      <p class="font-mono text-xs text-gray-500">
                        {release.label}, {release.year} · {release.format}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </CollapsibleSection>

    {/* Footer */}
    <footer class="pt-12">
      <div class="flex items-center justify-between">
        <p class="font-mono text-xs text-gray-400">
          © {year} Hélder Vasconcelos
          <span aria-hidden="true"> · </span>
          {/*
            The site is MIT, so say so where someone might act on it. Narrow
            screens get the fork glyph instead of the words — the footer line
            is tight on a phone, and the aria-label names the link either way,
            so the icon is never the only thing carrying the meaning.

            A fork glyph rather than the GitHub mark on purpose: the icon row
            to the right already has GitHub, pointing at the profile, and two
            identical marks in one footer would read as the same destination.
          */}
          <a
            href={sourceRepo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fork this site on GitHub"
            class="transition-colors hover:text-gray-900"
          >
            <svg
              class="inline h-4 w-4 align-middle sm:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="12" cy="18" r="3" />
              <circle cx="6" cy="6" r="3" />
              <circle cx="18" cy="6" r="3" />
              <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9" />
              <path d="M12 12v3" />
            </svg>
            <span
              class="hidden underline decoration-gray-200 underline-offset-4 transition-colors hover:decoration-gray-400 sm:inline"
              >fork it</span
            >
          </a>
        </p>
        <div class="flex items-center gap-4">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.name}
                class="text-gray-400 transition-colors hover:text-gray-900"
              >
                <SocialIcon platform={link.platform} />
              </a>
            ))
          }
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /*
   * CRT overlay on the avatar, revealed on hover: fixed scanlines plus a roll
   * bar sweeping down the tube. Both layers sit inside the clipped circle, so
   * they follow the photo as it scales.
   */
  .crt {
    background-image: repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.5) 0,
      rgb(0 0 0 / 0.5) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  /* The sweeping band, tinted with the same phosphor green as the caret. */
  .crt::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 45%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-terminal) 30%, transparent),
      transparent
    );
    animation: crt-roll 0.9s linear infinite;
  }

  @keyframes crt-roll {
    from {
      transform: translateY(-120%);
    }
    to {
      transform: translateY(220%);
    }
  }

  /* The scanlines are static and stay; only the moving band is dropped. */
  @media (prefers-reduced-motion: reduce) {
    .crt::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
