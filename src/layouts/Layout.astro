---
// The site is set entirely in JetBrains Mono. Inter is still a dependency but
// is deliberately not imported, so its files never reach the bundle.
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Overrides the default social card. Must be a path under public/. */
  image?: string
  /** Describes that card. Only worth setting alongside a custom `image`. */
  imageAlt?: string
  /** The card's real pixel size. Defaults to /og.png's. */
  imageWidth?: number
  imageHeight?: number
  /** The Markdown twin of this page, advertised as rel="alternate". */
  markdown?: string
  /**
   * Present only on article pages. Switches og:type, swaps the profile tags
   * for the article ones, and replaces the ProfilePage graph with a BlogPosting.
   */
  article?: { date: Date; tags: string[] }
}

const {
  title,
  description,
  // `image ?? '/og.png'` rather than a default parameter: a page that computes
  // its card from data passes undefined explicitly when there isn't one, and a
  // default only fires on a missing key.
  image,
  imageAlt = 'Hélder Vasconcelos — Chief Technology Officer at LayerX',
  imageWidth = 1200,
  imageHeight = 630,
  markdown = '/index.md',
  article,
} = Astro.props
/*
 * `build.format: 'file'` puts the .html back into Astro.url.pathname at build
 * time — /index.html, /articles/<slug>.html — while the URL everyone actually
 * uses has no extension. Stripping it here keeps the canonical, og:url and the
 * JSON-LD @ids pointing at the address the site is linked by. In `astro dev`
 * the pathname is already extensionless and this is a no-op.
 */
const pathname = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
const canonical = new URL(pathname, Astro.site)
const socialImage = new URL(image ?? '/og.png', Astro.site)

// Stable @id for the Person node, referenced from every other node in the
// JSON-LD graph below.
const site = Astro.site?.href
const personId = `${site}#helder-vasconcelos`

/*
 * A @graph rather than a bare Person, so the page, the site and the person are
 * separate nodes that reference each other by @id. That is what lets a consumer
 * tell "this page is about him" from "he wrote this", instead of inferring both
 * from one flat object.
 *
 * Two shapes: the profile graph for the homepage, and a BlogPosting for an
 * article. Both hang off the same personId, which is the anchor everything else
 * points at and must not change.
 */
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${site}#website`,
  url: site,
  name: 'Hélder Vasconcelos',
  inLanguage: 'en-GB',
  publisher: { '@id': personId },
}

const profileGraph = [
  {
    '@type': 'ProfilePage',
    '@id': `${site}#page`,
    url: canonical.href,
    name: title,
    description,
    inLanguage: 'en-GB',
    isPartOf: { '@id': `${site}#website` },
    about: { '@id': personId },
    mainEntity: { '@id': personId },
    primaryImageOfPage: socialImage.href,
  },
  { ...websiteNode, description },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Hélder Vasconcelos',
    alternateName: 'Helder Vasconcelos',
    givenName: 'Hélder',
    familyName: 'Vasconcelos',
    url: site,
    mainEntityOfPage: { '@id': `${site}#page` },
    image: socialImage.href,
    description,
    jobTitle: 'Chief Technology Officer',
    hasOccupation: {
      '@type': 'Occupation',
      name: 'Chief Technology Officer',
      occupationLocation: { '@type': 'City', name: 'Porto' },
    },
    worksFor: {
      '@type': 'Organization',
      name: 'LayerX',
      url: 'https://layerx.xyz',
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Universidade de Aveiro',
      url: 'https://www.ua.pt',
    },
    knowsAbout: [
      'Agentic workflows',
      'LLM inference',
      'High performance systems',
      'Real-time trading systems',
      'Distributed systems',
      'Apple Silicon and MLX',
      'Smart contracts and DeFi',
    ],
    knowsLanguage: ['en', 'pt'],
    nationality: { '@type': 'Country', name: 'Portugal' },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Porto',
      addressCountry: 'PT',
    },
    sameAs: [
      'https://github.com/hvasconcelos',
      'https://linkedin.com/in/heldervasc',
      'https://x.com/heldervasc',
      'https://taikai.network/heldervasc',
    ],
  },
  {
    '@type': 'Book',
    '@id': `${site}#asynchronous-android-programming`,
    name: 'Asynchronous Android Programming',
    bookEdition: 'Second Edition',
    author: { '@id': personId },
    publisher: { '@type': 'Organization', name: 'Packt Publishing' },
    datePublished: '2016',
    isbn: '9781785880165',
    url: 'https://www.packtpub.com/product/asynchronous-android-programming-second-edition/9781785880165',
  },
]

/*
 * The author is a compact Person rather than a bare { "@id": … } reference: the
 * full node lives on the homepage, and a consumer parsing one article page has
 * no way to resolve an @id it has never seen. The @id still matches, so the two
 * are the same entity to anything that reads both.
 */
const articleGraph = article && [
  websiteNode,
  {
    '@type': 'BlogPosting',
    '@id': `${canonical.href}#article`,
    headline: title,
    description,
    url: canonical.href,
    datePublished: article.date.toISOString(),
    dateModified: article.date.toISOString(),
    keywords: article.tags,
    inLanguage: 'en-GB',
    image: socialImage.href,
    isPartOf: { '@id': `${site}#website` },
    mainEntityOfPage: canonical.href,
    author: {
      '@type': 'Person',
      '@id': personId,
      name: 'Hélder Vasconcelos',
      url: site,
    },
    publisher: { '@id': personId },
  },
]

const graph = articleGraph || profileGraph

// Plausible — cookieless analytics, so there is nothing here to put behind a
// consent banner. Both values come from the environment rather than the
// repository, which matters twice over: `npm run dev` reports nothing, and a
// fork that does not set them ships no tracker instead of quietly counting
// its visitors into this site's dashboard.
// Read in frontmatter, which runs at build time, so they need no PUBLIC_
// prefix — the values still end up in the HTML, but only as the tag below.
// `||` rather than `??` on the host: an unset Docker ARG forwarded through ENV
// arrives as an empty string, not as undefined, and `??` would happily use it.
const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN
const plausibleSrc = `${(import.meta.env.PLAUSIBLE_HOST || 'https://plausible.io').replace(/\/+$/, '')}/js/script.js`
---

<!doctype html>
<!-- Dark is the served default, so it holds even with JavaScript disabled. -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Helder Vasconcelos" />
    <meta
      name="keywords"
      content="ai, software engineer, llm , agentic, open source"
    />
    <link rel="canonical" href={canonical} />

    {/*
      The whole icon set is cut from public/avatar.jpg by scripts/generate-icons.mjs.
      No SVG icon on purpose: browsers prefer image/svg+xml over everything
      else here, so one would quietly win over the photo.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      href="/favicon-96x96.png"
      type="image/png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    {/*
      The Markdown twin of this page — the homepage's is generated from the same
      src/data modules; an article's is its own source. Agents that would
      otherwise strip tags off the HTML can fetch this instead; /llms.txt points
      at them as well.
    */}
    <link
      rel="alternate"
      type="text/markdown"
      href={markdown}
      title="This page as Markdown"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title="Articles by Hélder Vasconcelos"
    />

    {/*
      Runs before first paint so the page never flashes the wrong theme.
      Must stay inline and unbundled — a deferred script would paint first.
    */}
    <script is:inline>
      ;(function () {
        // Dark is the default: the OS preference is deliberately not consulted,
        // so a visitor on a light system still lands on the dark theme. Only an
        // explicit choice from the toggle overrides it.
        var stored = localStorage.getItem('theme')
        document.documentElement.dataset.theme =
          stored === 'light' ? 'light' : 'dark'
      })()
    </script>

    {/*
      is:inline keeps Astro's bundler away from it — this has to stay the exact
      tag Plausible serves, loaded from their origin, not something rolled into
      the site's own JS.
    */}
    {
      plausibleDomain && (
        <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc} />
      )
    }

    <meta property="og:type" content={article ? 'article' : 'profile'} />
    <meta property="og:site_name" content="Hélder Vasconcelos - Personal Website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {/*
      og:type decides which of these two sets is meaningful, so only one of them
      is emitted — profile:* on an article is ignored at best and misread at worst.
    */}
    {
      article ? (
        <>
          <meta
            property="article:published_time"
            content={article.date.toISOString()}
          />
          <meta property="article:author" content={site} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      ) : (
        <>
          <meta property="profile:first_name" content="Hélder" />
          <meta property="profile:last_name" content="Vasconcelos" />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@heldervasc" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      })}
    />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
